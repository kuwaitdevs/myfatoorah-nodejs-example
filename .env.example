NODE_ENV=development
PORT=3000

# Public HTTPS origin used for success and error callbacks. For local testing,
# use an HTTPS tunnel such as ngrok or localhost.run.
APP_BASE_URL=https://your-public-host.example

# Never expose either token in browser or mobile code.
MYFATOORAH_TOKEN_DEV=
MYFATOORAH_TOKEN_PROD=

# Optional override for testing against a compatible mock server.
# MYFATOORAH_API_BASE_URL=https://apitest.myfatoorah.com