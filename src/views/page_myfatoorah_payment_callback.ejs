<div class="container">
    <div class="row mt-5 pt-3">
        <div class="col-12 col-lg-7 mx-auto">
            <div class="alert <%= data.captured ? 'alert-success' : 'alert-warning' %> text-center" role="alert">
                <h2 class="h4 mb-2"><%= data.message %></h2>
                <p class="mb-0">The status shown below was verified server-side with MyFatoorah.</p>
            </div>

            <table class="table table-striped table-bordered">
                <tbody>
                    <tr>
                        <th scope="row" class="w-50">Payment ID</th>
                        <td><%= data.paymentId %></td>
                    </tr>
                    <% for (const item of (data.invoiceItems || [])) { %>
                        <tr>
                            <th scope="row"><%= item.label %></th>
                            <td><%= item.value %></td>
                        </tr>
                    <% } %>
                </tbody>
            </table>

            <a href="/myfatoorah/payment/execute" class="btn btn-primary">Create another payment</a>
        </div>
    </div>
</div>
